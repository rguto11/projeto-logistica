# Copie para .env para sobrescrever os valores padrao do docker-compose.yml.
# Credenciais abaixo sao apenas didaticas: nunca use em producao.
POSTGRES_DB=logistica
POSTGRES_USER=logistica
# Repassada ao servico-dados como DB_PASSWORD, que NAO tem valor padrao no codigo
# (o docker-compose.yml fornece o padrao didatico logistica_pwd).
POSTGRES_PASSWORD=logistica_pwd

# Portas publicadas no host
PORTA_DADOS=8001
PORTA_PROCESSAMENTO=8002
PORTA_RELATORIO=8003
